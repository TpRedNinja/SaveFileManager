<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SavefileManager.Views.MessageDialog"
        SizeToContent="WidthAndHeight" MinWidth="340" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="480" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" MinWidth="84" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button x:Name="CancelButton" MinWidth="84" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
