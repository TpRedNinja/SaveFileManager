<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SavefileManager.Views.ColorPickerDialog"
        Title="Choose Color" SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

        <!-- Saturation / brightness square + hue bar -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Grid x:Name="SvBox" Width="240" Height="180" Background="Red" ClipToBounds="True" Cursor="Cross">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"/>
                    <Ellipse x:Name="SvMarkerOuter" Width="16" Height="16" Stroke="Black" StrokeThickness="1"/>
                </Canvas>
            </Grid>
            <Grid x:Name="HueBar" Width="240" Height="20" Margin="0,10,0,0" Cursor="Hand">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#FFFF0000" Offset="0"/>
                        <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                        <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                        <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                        <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FFFF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker" Width="5" Height="20" Stroke="Black" StrokeThickness="1" Fill="White"/>
                </Canvas>
            </Grid>
        </StackPanel>

        <!-- Numbers + preview -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Width="150">
            <TextBlock Text="New / Current" Margin="0,0,0,4"/>
            <Grid Height="44" Margin="0,0,0,12" ColumnDefinitions="*,*">
                <Border x:Name="NewSwatch" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"/>
                <Border x:Name="OldSwatch" Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"
                        Cursor="Hand" ToolTip.Tip="Click to go back to the original color"/>
            </Grid>

            <Grid Margin="0,0,0,6" ColumnDefinitions="28,*">
                <TextBlock Text="R" VerticalAlignment="Center"/>
                <TextBox x:Name="RBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,6" ColumnDefinitions="28,*">
                <TextBlock Text="G" VerticalAlignment="Center"/>
                <TextBox x:Name="GBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,6" ColumnDefinitions="28,*">
                <TextBlock Text="B" VerticalAlignment="Center"/>
                <TextBox x:Name="BBox" Grid.Column="1"/>
            </Grid>
            <Grid ColumnDefinitions="28,*">
                <TextBlock Text="#" VerticalAlignment="Center"/>
                <TextBox x:Name="HexBox" Grid.Column="1" MaxLength="7"/>
            </Grid>
        </StackPanel>

        <!-- Preset swatches -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Presets" Margin="0,14,0,4"/>
        <WrapPanel x:Name="PresetPanel" Grid.Row="2" Grid.ColumnSpan="2" Width="406" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" MinWidth="84" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" MinWidth="84" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
