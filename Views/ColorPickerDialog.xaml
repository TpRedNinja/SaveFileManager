<Window x:Class="SavefileManager.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource Font.General}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Saturation / brightness square + hue bar -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Grid x:Name="SvBox" Width="240" Height="180" Background="Red" ClipToBounds="True" Cursor="Cross"
                  MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Sv_Up">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"/>
                    <Ellipse x:Name="SvMarkerOuter" Width="16" Height="16" Stroke="Black" StrokeThickness="1"/>
                </Canvas>
            </Grid>
            <Grid x:Name="HueBar" Width="240" Height="20" Margin="0,10,0,0" Cursor="Hand"
                  MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0"/>
                        <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                        <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                        <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                        <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FFFF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker" Width="5" Height="20" Stroke="Black" StrokeThickness="1" Fill="White"/>
                </Canvas>
            </Grid>
        </StackPanel>

        <!-- Numbers + preview -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Width="150">
            <TextBlock Text="New / Current" Margin="0,0,0,4"/>
            <Grid Height="44" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="NewSwatch" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"/>
                <Border x:Name="OldSwatch" Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"
                        Cursor="Hand" ToolTip="Click to go back to the original color"
                        MouseLeftButtonDown="OldSwatch_Click"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center"/>
                <TextBox x:Name="RBox" Grid.Column="1" TextChanged="Rgb_Changed"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" VerticalAlignment="Center"/>
                <TextBox x:Name="GBox" Grid.Column="1" TextChanged="Rgb_Changed"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" VerticalAlignment="Center"/>
                <TextBox x:Name="BBox" Grid.Column="1" TextChanged="Rgb_Changed"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" VerticalAlignment="Center"/>
                <TextBox x:Name="HexBox" Grid.Column="1" TextChanged="Hex_Changed" MaxLength="7"/>
            </Grid>
        </StackPanel>

        <!-- Preset swatches -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Presets" Margin="0,14,0,4"/>
        <WrapPanel x:Name="PresetPanel" Grid.Row="2" Grid.ColumnSpan="2" Width="406" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" MinWidth="84" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" MinWidth="84" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
