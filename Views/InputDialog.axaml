<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SavefileManager.Views.InputDialog"
        SizeToContent="Height" Width="400" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Opened="Window_Opened">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" MinWidth="84" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" MinWidth="84" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
