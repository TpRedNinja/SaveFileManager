<Window x:Class="SavefileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SavefileManager.Models"
        Title="Savefile Manager" Width="780" Height="580" MinWidth="600" MinHeight="440"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource Font.General}" FontSize="13"
        Loaded="Window_Loaded" Activated="Window_Activated" Closing="Window_Closing">

    <Window.Resources>
        <!-- How a file / folder row looks in both lists -->
        <HierarchicalDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource FileTreeItemStyle}">
            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding FullPath}">
                <Grid Width="22" Height="20" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding CustomIcon}" Width="20" Height="20" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="PathLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PathTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Paths}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PathHoverTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ArrowButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Menu bar ================= -->
        <Menu Grid.Row="0">
            <MenuItem Header="Options">
                <MenuItem Header="Add" Click="AddProfile_Click"/>
                <MenuItem x:Name="EditMenu" Header="Edit" Click="EditProfile_Click"/>
                <MenuItem x:Name="RemoveMenu" Header="Remove" Click="RemoveProfile_Click"/>
                <Separator/>
                <MenuItem x:Name="FixPathsMenu" Header="Set folders for this PC..." Click="FixPaths_Click"/>
                <Separator/>
                <MenuItem x:Name="SetProfileIconMenu" Header="Set profile icon..." Click="SetProfileIcon_Click"/>
                <MenuItem x:Name="RemoveProfileIconMenu" Header="Remove profile icon" Click="RemoveProfileIcon_Click"/>
                <Separator/>
                <MenuItem Header="Import Green-Bat settings.json..." Click="ImportLegacy_Click"/>
                <MenuItem Header="Open backups folder" Click="OpenBackups_Click"/>
                <MenuItem Header="Clean backups older than 7 days..." Click="CleanBackups_Click"/>
            </MenuItem>
            <MenuItem x:Name="ThemesMenu" Header="Themes"/>
        </Menu>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="1" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" FontFamily="{DynamicResource Font.Title}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Profiles:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfileCombo" Width="240" SelectionChanged="ProfileCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock x:Name="PersonalPathText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                       Style="{StaticResource PathLabelStyle}"
                       ToolTip="Double-click to open this folder"
                       MouseLeftButtonDown="PersonalPath_MouseDown"/>
            <TextBlock x:Name="GamePathText" Grid.Row="2" Grid.ColumnSpan="2"
                       Style="{StaticResource PathLabelStyle}"
                       ToolTip="Double-click to open this folder"
                       MouseLeftButtonDown="GamePath_MouseDown"/>
        </Grid>

        <!-- ================= Folder-missing banner (profile is kept, just inaccessible) ================= -->
        <Border x:Name="MissingBanner" Grid.Row="2" Margin="16,6,16,0" Padding="10,8" Visibility="Collapsed"
                CornerRadius="3" BorderThickness="1"
                Background="{DynamicResource TreeBackgroundBrush}"
                BorderBrush="{DynamicResource UnavailableTextBrush}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Set folders for this PC..." Margin="12,0,0,0"
                        Click="FixPaths_Click"/>
                <TextBlock x:Name="MissingBannerText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource UnavailableTextBrush}"/>
            </DockPanel>
        </Border>

        <!-- ================= Lists ================= -->
        <Grid Grid.Row="3" Margin="16,10,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="Your saves" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <TextBlock Grid.Column="2" Text="Game saves" FontWeight="SemiBold" Margin="2,0,0,4"/>

            <TreeView x:Name="PersonalTree" Grid.Row="1" Grid.Column="0"
                      Tag="{DynamicResource PersonalImageBrush}"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"/>

            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="ReplaceButton" Content="=&gt;" Style="{StaticResource ArrowButtonStyle}"
                        ToolTip="Replace the selected game save with the selected save from your list"
                        Click="Replace_Click"/>
                <Button x:Name="BackupButton" Content="&lt;=" Style="{StaticResource ArrowButtonStyle}"
                        ToolTip="Back up the selected game save into your list (into the selected folder, or the main folder if nothing is selected)"
                        Click="Backup_Click"/>
            </StackPanel>

            <TreeView x:Name="GameTree" Grid.Row="1" Grid.Column="2"
                      Tag="{DynamicResource GameImageBrush}"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"/>
        </Grid>
    </Grid>
</Window>
